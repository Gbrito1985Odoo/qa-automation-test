{
  "name": "qa-automation-test",
  "version": "1.0.0",
  "private": true,
  "description": "QA Automation — Playwright + API + JMeter + OWASP + Manual QA",
  "scripts": {
    "lint": "eslint . --ext .ts,.cjs",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:smoke": "playwright test --config e2e/playwright.config.ts --grep @smoke",
    "test:critical": "playwright test --config e2e/playwright.config.ts --grep @critical",
    "test:regression": "playwright test --config e2e/playwright.config.ts --grep @regression",
    "test:api": "playwright test --config api/playwright.config.ts",
    "jmeter:load": "jmeter -n -t load/plan.jmx -l load/results.jtl -e -o load/report",
    "report:html": "ts-node scripts/generate-report.ts",
    "cleanup": "ts-node scripts/cleanup.ts",
    "security:check": "ts-node scripts/security-check.ts",
    "manual:lint": "ts-node scripts/manual-lint.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "ajv": "^8.17.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
